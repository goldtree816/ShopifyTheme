


 <!-- sections/featured-collections.liquid -->
<section class="featured-collections">
  <link rel="stylesheet" href="{{ 'featured-collections.css' | asset_url }}">
  
  <div class="featured-collections__container">
    <!-- Hero Section with Image and Text -->
    <div class="featured-collections__hero">
      {% comment %} <div id="hero-image-one" class="featured-collections__hero-image">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | img_url: '800x600' }}" 
               alt="{{ section.settings.heading | escape }}" 
               class="hero-image" 
               loading="lazy" />
        {% endif %}
        <div class="hero-overlay"></div>
      </div> {% endcomment %}

       {% comment %} <div id="hero-image-two" class="featured-collections__hero-image">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image_two | img_url: '800x600' }}" 
               alt="{{ section.settings.heading | escape }}" 
               class="hero-image" 
               loading="lazy" />
        {% endif %}
        <div class="hero-overlay"></div>
      </div> {% endcomment %}

      <div class="slider-container">
    <div class="slider" id="slider">
      <div class="slide slide1">
       
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image | img_url: '800x600' }}" 
               alt="{{ section.settings.heading | escape }}" 
               class="hero-image" 
               loading="lazy" />
        {% endif %}
     
      </div>
      <div class="slide slide2">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image_two | img_url: '800x600' }}" 
               alt="{{ section.settings.heading | escape }}" 
               class="hero-image" 
               loading="lazy" />
        {% endif %}
      </div>
      <div class="slide slide3">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image_three| img_url: '800x600' }}" 
               alt="{{ section.settings.heading | escape }}" 
               class="hero-image" 
               loading="lazy" />
        {% endif %}
      </div>
    </div>
     <div class="buttons">
    <button onclick="prevSlide()">⬅️ Prev</button>
    <button onclick="nextSlide()">Next ➡️</button>
  </div>
  </div>

  


       {% comment %} <div id="hero-image-three" class="featured-collections__hero-image">
        {% if section.settings.hero_image %}
          <img src="{{ section.settings.hero_image_three | img_url: '400x300' }}" 
               alt="{{ section.settings.heading | escape }}" 
               class="hero-image" 
               loading="lazy" />
        {% endif %}
        <div class="hero-overlay"></div>
      </div> {% endcomment %}
      
      <div class="featured-collections__hero-content">
        <h2 class="featured-collections__title">{{ section.settings.heading | default: 'We are carbon fiber obsessed' }}</h2>
        <p class="featured-collections__subtitle">{{ section.settings.subheading | default: 'We love carbon fiber for its famous tensile strength, curious light weight nature and of course aesthetic. Our racquets are made with anywhere from 3K to 18K carbon fiber, the same used by professional paddle players and utilized in aerospace and race car parts. ALL of our racquets are reinforced with carbon fiber tubing for added durability.' }}</p>
         <p class="featured-collections__subtitle">{{ section.settings.subheading_two | default: 'We love carbon fiber for its famous tensile strength, curious light weight nature and of course aesthetic. Our racquets are made with anywhere from 3K to 18K carbon fiber, the same used by professional paddle players and utilized in aerospace and race car parts. ALL of our racquets are reinforced with carbon fiber tubing for added durability.' }}</p>
         <p class="featured-collections__subtitle">{{ section.settings.subheading_three | default: 'We love carbon fiber for its famous tensile strength, curious light weight nature and of course aesthetic. Our racquets are made with anywhere from 3K to 18K carbon fiber, the same used by professional paddle players and utilized in aerospace and race car parts. ALL of our racquets are reinforced with carbon fiber tubing for added durability.' }}</p>
        
        
        {% if section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_url | default: '#collections' }}" class="hero-cta">
            {{ section.settings.cta_text }}
            <span class="cta-icon">→</span>
          </a>
        {% endif %}
      </div>
    </div>

   
 


    

  </div>
</section>


 <script>
    let currentIndex = 0;
    const slides = document.querySelectorAll('.slide');
    const totalSlides = slides.length;
    const slider = document.getElementById('slider');

    function showSlide(index) {
      if (index < 0) {
        currentIndex = totalSlides - 1; // Go to last slide
      } else if (index >= totalSlides) {
        currentIndex = 0; // Go to first slide
      } else {
        currentIndex = index;
      }
      slider.style.transform = `translateX(-${currentIndex * 600}px)`;
    }

    function nextSlide() {
      showSlide(currentIndex + 1);
    }

    function prevSlide() {
      showSlide(currentIndex - 1);
    }
  </script>



<!-- CSS Styles -->
<style>
.featured-collections {
  padding: 0;
  margin: 0;
  background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
  color: white;
  overflow: hidden;
}

.featured-collections__container {
  max-width: 1400px;
  margin: 0 auto;
}

/* Hero Section */
.featured-collections__hero {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 600px;
  align-items: center;
}

.featured-collections__hero-image {
  position: relative;
  height: 100%;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, rgba(0,0,0,0.3) 0%, transparent 70%);
}

.featured-collections__hero-content {
  padding: 60px 80px;
  z-index: 2;
  position: relative;
}

.featured-collections__title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 24px;
  background: linear-gradient(135deg, #ffffff 0%, #f0f0f0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.featured-collections__subtitle {
  font-size: 1.1rem;
  line-height: 1.6;
  color: #e0e0e0;
  margin-bottom: 32px;
  max-width: 500px;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 16px 32px;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: white;
  text-decoration: none;
  border-radius: 50px;
  font-weight: 600;
  font-size: 1.1rem;
  transition: all 0.3s ease;
  box-shadow: 0 4px 20px rgba(76, 175, 80, 0.3);
}

.hero-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(76, 175, 80, 0.4);
}

.cta-icon {
  font-size: 1.2rem;
  transition: transform 0.3s ease;
}

.hero-cta:hover .cta-icon {
  transform: translateX(4px);
}

/* Collections Section */
.featured-collections__grid {
  padding: 80px 40px;
}

.collections-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 32px;
  margin-top: 40px;
}

.collection-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.collection-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  background: rgba(255, 255, 255, 0.08);
}

.collection-card__image-container {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
}

.collection-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.collection-card:hover .collection-card__image {
  transform: scale(1.05);
}

.collection-badge {
  position: absolute;
  top: 16px;
  right: 16px;
  background: #4CAF50;
  color: white;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
  z-index: 2;
}

.collection-card__overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.collection-card:hover .collection-card__overlay {
  opacity: 1;
}

.collection-card__quick-view {
  padding: 12px 24px;
  background: white;
  color: #333;
  text-decoration: none;
  border-radius: 25px;
  font-weight: 600;
  transition: all 0.3s ease;
}

.collection-card__quick-view:hover {
  background: #4CAF50;
  color: white;
  transform: scale(1.05);
}

.collection-card__content {
  padding: 24px;
  text-align: center;
}

.collection-card__title {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 12px;
  color: #ffffff;
}

.collection-card__description {
  font-size: 0.95rem;
  color: #cccccc;
  line-height: 1.5;
  margin-bottom: 20px;
}

.collection-card__cta {
  display: inline-block;
  padding: 12px 24px;
  background: transparent;
  color: white;
  text-decoration: none;
  border: 2px solid #4CAF50;
  border-radius: 25px;
  font-weight: 600;
  transition: all 0.3s ease;
}

.collection-card__cta:hover {
  background: #4CAF50;
  transform: translateY(-2px);
}

.no-collections {
  text-align: center;
  padding: 60px 20px;
  color: #999;
}










 .slider-container {
      width: 600px;
      overflow: hidden;
      margin: auto;
      border: 2px solid #333;
      position: relative;
    }

    .slider {
      display: flex;
      transition: transform 0.5s ease-in-out;
    }

    .slide {
      min-width: 600px;
      height: 600px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      font-weight: bold;
      color: white;
    }

    .slide1 { background: crimson; }
    .slide2 { background: seagreen; }
    .slide3 { background: royalblue; }

    .buttons {
      display: flex;
      justify-content: space-between;
      {% comment %} margin-top: 10px; {% endcomment %}
      margin-bottom :80px
    }

    button {
      padding: 10px 15px;
      font-size: 16px;
      cursor: pointer;
    }



/* Responsive Design */
@media (max-width: 768px) {
  .featured-collections__hero {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  
  .featured-collections__hero-content {
    padding: 40px 20px;
    order: 2;
  }
  
  .featured-collections__hero-image {
    height: 400px;
    order: 1;
  }
  
  .featured-collections__title {
    font-size: 2.5rem;
  }
  
  .featured-collections__grid {
    padding: 40px 20px;
  }
  
  .collections-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
}

@media (max-width: 480px) {
  .featured-collections__hero-content {
    padding: 30px 20px;
  }
  
  .featured-collections__title {
    font-size: 2rem;
  }
  
  .featured-collections__subtitle {
    font-size: 1rem;
  }
  
  .collections-grid {
    grid-template-columns: 1fr;
  }
}
</style>

