    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Button background",
      "default": "#CDAA7D"
    },
    {
      "type": "color",
      "id": "cta_bg_hover",
      "label": "Button background (hover)",
      "default": "#DB2955"
    },
    {
      "type": "color",
      "id": "cta_text",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %} {% endcomment %}


{{ 'hero-banner.css' | asset_url | stylesheet_tag }}
{% comment %} <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glider-js@1/glider.min.css"> {% endcomment %}

<section class="hero-banner" style="--hero-bg: {{ section.settings.bg_color }}; --hero-text: {{ section.settings.text_color }}; --hero-cta-bg: {{ section.settings.cta_bg }}; --hero-cta-text: {{ section.settings.cta_text }}; --hero-cta-bg-hover: {{ section.settings.cta_bg_hover }};">
  {% comment %} <div class="hero-banner__content"> {% endcomment %}
    {% comment %} {% if section.settings.video != blank %}
      <video 
        class="hero-banner__video"
        src="{{ section.settings.video }}"
        autoplay
        muted
        loop
        playsinline
        width="100%"
        height="1080">
      </video>
    {% elsif section.settings.image != blank %}
      <img class="hero-banner__image"
           src="{{ section.settings.image | image_url: width: 1920 }}"
           alt="{{ section.settings.image.alt | default: 'Hero banner image' }}"
           width="1920"
           height="1080"
           loading="eager" />
    {% else %}
      {% comment %} <img class="hero-banner__fallback-img" {% endcomment %}
           src="{{ 'bamboo.jpg' | asset_url }}"
           alt="AuraWear fallback image"
           width="100vh"
           height="2000"
           loading="eager" />
    {% endif %}
    
    <!-- Secondary sliding image -->
    {% if section.settings.secondary_image != blank %}
      <img class="hero-banner__secondary-image"
           src="{{ section.settings.secondary_image | image_url: width: 1920 }}"
           alt="{{ section.settings.secondary_image.alt | default: 'Secondary hero image' }}"
           width="1920"
           height="1080"
           loading="eager" />
    {% else %}
      <img class="hero-banner__secondary-image"
           src="{{ 'bamboo-one.jpg' | asset_url }}"
           alt="Bamboo secondary image"
           width="1920"
           height="1080"
           loading="eager" />
    {% endif %} {% endcomment %}


     <img class="hero-banner__secondary-image"
           src="{{ 'bamboo-one.jpg' | asset_url }}"
           alt="Bamboo secondary image"
           width="100vh"
           height="100vh"
           loading="eager" />
    {% comment %} {% endif %} {% endcomment %}
   
  {% comment %} </div> {% endcomment %}
</section>

<style>
.hero-banner__secondary-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  will-change: transform;
}

.hero-banner__overlay {
  z-index: 3;
}

.hero-banner__image,
.hero-banner__video,
.hero-banner__fallback-img {
  z-index: 2;
}
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // GSAP Timeline for hero banner animations
  const tl = gsap.timeline();
  
  // Set initial states
 
  gsap.set('.hero-banner__secondary-image', {
    x: '100%',
    opacity: 1,
    scale: 1
  });
  
 
  
 
  
  
  
  // Animation sequence

  // Register ScrollTrigger plugin
  gsap.registerPlugin(ScrollTrigger);
  
  // Vertical parallax effect on main image/video

  
  // Horizontal sliding animation for secondary image
  const secondaryImage = document.querySelector('.hero-banner__secondary-image');
  if (secondaryImage) {
    gsap.fromTo('.hero-banner__secondary-image', 
      {
        x: '100%'
      },
      {
        x: '-100%',
        ease: "none",
        scrollTrigger: {
          trigger: ".hero-banner",
          start: "top bottom",
          end: "bottom top",
          scrub: 1.5,
          invalidateOnRefresh: true
        }
      }
    );
  }
  
  // Text elements fade and slide based on scroll
 
  
  // Button hover animations
 
});
</script>

